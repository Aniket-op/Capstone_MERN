DATABASE_URL="mongodb://127.0.0.1:27017/capstone"
JWT_SECRET="your_jwt_secret_here"

# MQTT Broker
MQTT_BROKER_URL=mqtt://broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_SENSOR=solar/sensor/data
MQTT_TOPIC_COMMAND=solar/command

# ML Server
ML_SERVER_URL=http://localhost:8000
ML_PREDICT_ENDPOINT=/predict

# Server
PORT=5000
NODE_ENV=development